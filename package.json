{
  "name": "medicare-hospital",
  "version": "1.0.0",
  "private": true,
  "description": "Root command entry point for the Medicare Hospital frontend and API",
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node scripts/start-local.mjs",
    "dev": "node scripts/start-local.mjs",
    "build": "npm run frontend:build",
    "lint": "npm --prefix frontend run lint",
    "test": "npm run backend:test",
    "check": "npm run lint && npm --prefix backend run check && npm run backend:test",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:start": "npm --prefix frontend run start",
    "backend:dev": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend run start",
    "backend:test": "npm --prefix backend run test"
  }
}
