{
  "name": "medicare-hospital-api",
  "version": "1.0.0",
  "private": true,
  "description": "Production-minded REST API for the Medicare hospital platform",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node --watch src/server.js",
    "start": "npm run db:deploy && node src/server.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test --test-concurrency=1",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "build": "npm run prisma:generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "prisma": "^6.19.3",
    "sanitize-html": "^2.17.0",
    "sharp": "0.35.3",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "supertest": "^7.1.0"
  }
}
