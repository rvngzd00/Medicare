NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:replace_me@localhost:5432/medicare?schema=public
# Append the exact LAN frontend origin when testing from another device.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100

# Generate independent, high-entropy values (at least 32 characters).
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_COOKIE_NAME=medicare_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

LOG_LEVEL=info
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
UPLOAD_MAX_MB=8
UPLOAD_DIR=uploads

# Optional. The seed creates an initial administrator only when both are set.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
