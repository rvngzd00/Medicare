generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum MessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

enum MediaProvider {
  LOCAL
  S3
}

enum NavigationLocation {
  HEADER
  FOOTER
  UTILITY
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id                  String           @id @default(uuid())
  email               String           @unique
  passwordHash        String
  firstName           String
  lastName            String
  status              UserStatus       @default(ACTIVE)
  failedLoginAttempts Int              @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  roleId              String
  role                Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens       RefreshToken[]
  articles            Article[]        @relation("ArticleAuthor")
  assignedMessages    ContactMessage[] @relation("MessageAssignee")
  uploadedMedia       MediaFile[]      @relation("MediaUploader")
  activityLogs        ActivityLog[]    @relation("ActivityActor")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  @@index([roleId, status])
  @@index([deletedAt])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  slug        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id                  String    @id @default(uuid())
  tokenHash           String    @unique
  familyId            String
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdByIp         String?
  userAgent           String?
  createdAt           DateTime  @default(now())

  @@index([userId, familyId])
  @@index([expiresAt])
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation("ActivityActor", fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  method     String?
  path       String?
  statusCode Int?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model MediaFile {
  id                        String                     @id @default(uuid())
  provider                  MediaProvider              @default(LOCAL)
  storageKey                String                     @unique
  filename                  String
  originalName              String
  mimeType                  String
  size                      Int
  width                     Int?
  height                    Int?
  url                       String
  thumbnailUrl              String?
  altText                   String?
  uploadedById              String?
  uploadedBy                User?                      @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  doctorImages              Doctor[]                   @relation("DoctorImage")
  departmentImages          Department[]               @relation("DepartmentImage")
  serviceImages             Service[]                  @relation("ServiceImage")
  branchImages              Branch[]                   @relation("BranchImage")
  articleImages             Article[]                  @relation("ArticleCover")
  testimonialImages         Testimonial[]              @relation("TestimonialImage")
  galleryItems              GalleryItem[]              @relation("GalleryMedia")
  certificateFiles          Certificate[]              @relation("CertificateMedia")
  leadershipImages          LeadershipMember[]         @relation("LeadershipImage")
  seoImages                 SeoMetadata[]              @relation("SeoOgImage")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?

  @@index([uploadedById])
  @@index([deletedAt])
}

model SeoMetadata {
  id             String       @id @default(uuid())
  pageKey        String?      @unique
  title          String
  description    String
  canonicalUrl   String?
  keywords       String[]     @default([])
  robots         String       @default("index,follow")
  ogTitle        String?
  ogDescription  String?
  ogImageId      String?
  ogImage        MediaFile?   @relation("SeoOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  twitterCard    String       @default("summary_large_image")
  structuredData Json?
  doctor         Doctor?
  department     Department?
  service        Service?
  branch         Branch?
  article        Article?
  contentPage    ContentPage?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([ogImageId])
}

model Doctor {
  id              String              @id @default(uuid())
  slug            String              @unique
  firstName       String
  lastName        String
  title           String?
  specialty       String
  shortBio        String
  bio             String
  experienceYears Int                 @default(0)
  phone           String?
  email           String?
  languages       String[]            @default([])
  conditions      String[]            @default([])
  procedures      String[]            @default([])
  socialLinks     Json?
  departmentId    String
  department      Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  branchId        String?
  branch          Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  profileImageId  String?
  profileImage    MediaFile?          @relation("DoctorImage", fields: [profileImageId], references: [id], onDelete: SetNull)
  seoId           String?             @unique
  seo             SeoMetadata?        @relation(fields: [seoId], references: [id], onDelete: SetNull)
  active          Boolean             @default(true)
  featured        Boolean             @default(false)
  sortOrder       Int                 @default(0)
  educations      DoctorEducation[]
  experiences     DoctorExperience[]
  certificates    DoctorCertificate[]
  schedules       DoctorSchedule[]
  services        Service[]
  testimonials    Testimonial[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  @@index([departmentId, active, sortOrder])
  @@index([branchId])
  @@index([specialty])
  @@index([featured])
  @@index([deletedAt])
}

model DoctorEducation {
  id          String   @id @default(uuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  institution String
  degree      String
  field       String?
  startYear   Int?
  endYear     Int?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([doctorId, sortOrder])
}

model DoctorExperience {
  id           String    @id @default(uuid())
  doctorId     String
  doctor       Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  organization String
  position     String
  startDate    DateTime?
  endDate      DateTime?
  current      Boolean   @default(false)
  description  String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([doctorId, sortOrder])
}

model DoctorCertificate {
  id            String    @id @default(uuid())
  doctorId      String
  doctor        Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  title         String
  issuer        String?
  issuedAt      DateTime?
  expiresAt     DateTime?
  credentialUrl String?
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([doctorId, sortOrder])
}

model DoctorSchedule {
  id          String   @id @default(uuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dayOfWeek   WeekDay
  startTime   String
  endTime     String
  slotMinutes Int      @default(30)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([doctorId, branchId, dayOfWeek, startTime])
  @@index([branchId, dayOfWeek])
}

model Department {
  id           String        @id @default(uuid())
  slug         String        @unique
  name         String
  summary      String
  description  String
  conditions   String[]      @default([])
  technologies String[]      @default([])
  phone        String?
  imageId      String?
  image        MediaFile?    @relation("DepartmentImage", fields: [imageId], references: [id], onDelete: SetNull)
  seoId        String?       @unique
  seo          SeoMetadata?  @relation(fields: [seoId], references: [id], onDelete: SetNull)
  active       Boolean       @default(true)
  featured     Boolean       @default(false)
  sortOrder    Int           @default(0)
  doctors      Doctor[]
  services     Service[]
  branches     Branch[]
  faqs         FAQ[]
  testimonials Testimonial[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  @@index([active, sortOrder])
  @@index([featured])
  @@index([deletedAt])
}

model Service {
  id           String       @id @default(uuid())
  slug         String       @unique
  name         String
  summary      String
  description  String
  priceFrom    Decimal?     @db.Decimal(12, 2)
  currency     String       @default("AZN")
  icon         String?
  imageId      String?
  image        MediaFile?   @relation("ServiceImage", fields: [imageId], references: [id], onDelete: SetNull)
  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  seoId        String?      @unique
  seo          SeoMetadata? @relation(fields: [seoId], references: [id], onDelete: SetNull)
  active       Boolean      @default(true)
  featured     Boolean      @default(false)
  sortOrder    Int          @default(0)
  doctors      Doctor[]
  faqs         FAQ[]
  priceItems   ServicePriceItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  @@index([departmentId, active, sortOrder])
  @@index([featured])
  @@index([deletedAt])
}

model ServicePriceItem {
  id        String   @id @default(uuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  code      String?
  name      String
  price     Decimal? @db.Decimal(12, 2)
  currency  String   @default("AZN")
  note      String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId, active, sortOrder])
  @@index([name])
}

model Branch {
  id             String           @id @default(uuid())
  slug           String           @unique
  name           String
  address        String
  city           String
  postalCode     String?
  phone          String
  email          String?
  emergencyPhone String?
  latitude       Decimal?         @db.Decimal(10, 7)
  longitude      Decimal?         @db.Decimal(10, 7)
  workingHours   Json?
  mapEmbedUrl    String?
  imageId        String?
  image          MediaFile?       @relation("BranchImage", fields: [imageId], references: [id], onDelete: SetNull)
  seoId          String?          @unique
  seo            SeoMetadata?     @relation(fields: [seoId], references: [id], onDelete: SetNull)
  active         Boolean          @default(true)
  sortOrder      Int              @default(0)
  departments    Department[]
  doctors        Doctor[]
  schedules      DoctorSchedule[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  @@index([active, sortOrder])
  @@index([city])
  @@index([deletedAt])
}

model ContactMessage {
  id             String        @id @default(uuid())
  firstName      String
  lastName       String?
  email          String
  phone          String?
  subject        String
  message        String
  privacyConsent Boolean
  status         MessageStatus @default(NEW)
  adminNotes     String?
  assignedToId   String?
  assignedTo     User?         @relation("MessageAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([status, createdAt])
  @@index([assignedToId])
  @@index([deletedAt])
}

model ArticleCategory {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  description String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  articles    Article[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([active, sortOrder])
}

model Article {
  id                String            @id @default(uuid())
  slug              String            @unique
  title             String
  excerpt           String
  body              Json
  status            ContentStatus     @default(DRAFT)
  featured          Boolean           @default(false)
  readingMinutes    Int               @default(1)
  viewCount         Int               @default(0)
  publishedAt       DateTime?
  scheduledAt       DateTime?
  authorId          String?
  author            User?             @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  coverImageId      String?
  coverImage        MediaFile?        @relation("ArticleCover", fields: [coverImageId], references: [id], onDelete: SetNull)
  seoId             String?           @unique
  seo               SeoMetadata?      @relation(fields: [seoId], references: [id], onDelete: SetNull)
  categories        ArticleCategory[]
  outgoingRelations ArticleRelation[] @relation("RelatedFrom")
  incomingRelations ArticleRelation[] @relation("RelatedTo")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  @@index([status, publishedAt])
  @@index([featured])
  @@index([authorId])
  @@index([deletedAt])
}

model ArticleRelation {
  articleId        String
  relatedArticleId String
  article          Article @relation("RelatedFrom", fields: [articleId], references: [id], onDelete: Cascade)
  relatedArticle   Article @relation("RelatedTo", fields: [relatedArticleId], references: [id], onDelete: Cascade)
  sortOrder        Int     @default(0)

  @@id([articleId, relatedArticleId])
  @@index([relatedArticleId])
}

model FAQ {
  id           String      @id @default(uuid())
  question     String
  answer       String
  category     String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  serviceId    String?
  service      Service?    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  active       Boolean     @default(true)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  @@index([departmentId, active, sortOrder])
  @@index([serviceId])
  @@index([deletedAt])
}

model Testimonial {
  id           String      @id @default(uuid())
  patientName  String
  patientTitle String?
  quote        String
  rating       Int         @default(5)
  doctorId     String?
  doctor       Doctor?     @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  imageId      String?
  image        MediaFile?  @relation("TestimonialImage", fields: [imageId], references: [id], onDelete: SetNull)
  active       Boolean     @default(true)
  featured     Boolean     @default(false)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  @@index([active, sortOrder])
  @@index([featured])
  @@index([deletedAt])
}

model GalleryItem {
  id          String    @id @default(uuid())
  title       String
  description String?
  category    String?
  mediaId     String
  media       MediaFile @relation("GalleryMedia", fields: [mediaId], references: [id], onDelete: Restrict)
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([active, sortOrder])
  @@index([category])
  @@index([deletedAt])
}

model Certificate {
  id               String     @id @default(uuid())
  title            String
  issuer           String
  description      String?
  credentialNumber String?
  issuedAt         DateTime?
  expiresAt        DateTime?
  mediaId          String?
  media            MediaFile? @relation("CertificateMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  active           Boolean    @default(true)
  sortOrder        Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  @@index([active, sortOrder])
  @@index([deletedAt])
}

model LeadershipMember {
  id         String     @id @default(uuid())
  slug       String     @unique
  firstName  String
  lastName   String
  position   String
  bio        String
  education  String[]   @default([])
  experience String[]   @default([])
  imageId    String
  image      MediaFile  @relation("LeadershipImage", fields: [imageId], references: [id], onDelete: Restrict)
  active     Boolean    @default(true)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  @@index([active, sortOrder])
  @@index([deletedAt])
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  group     String
  label     String?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group, isPublic])
}

model NavigationItem {
  id         String             @id @default(uuid())
  label      String
  url        String
  location   NavigationLocation
  parentId   String?
  parent     NavigationItem?    @relation("NavigationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   NavigationItem[]   @relation("NavigationTree")
  isExternal Boolean            @default(false)
  active     Boolean            @default(true)
  sortOrder  Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?

  @@index([location, active, sortOrder])
  @@index([parentId])
  @@index([deletedAt])
}

model ContentPage {
  id        String            @id @default(uuid())
  slug      String            @unique
  title     String
  excerpt   String?
  body      Json
  template  String            @default("STANDARD")
  status    ContentStatus     @default(DRAFT)
  seoId     String?           @unique
  seo       SeoMetadata?      @relation(fields: [seoId], references: [id], onDelete: SetNull)
  sections  PageSection[]
  revisions ContentRevision[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([deletedAt])
}

model PageSection {
  id          String      @id @default(uuid())
  pageId      String
  page        ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key         String
  type        String      @default("RICH_TEXT")
  label       String
  eyebrow     String?
  title       String?
  description String?
  content     Json
  active      Boolean     @default(true)
  locked      Boolean     @default(false)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@unique([pageId, key])
  @@index([pageId, active, sortOrder])
  @@index([deletedAt])
}

model ContentRevision {
  id         String      @id @default(uuid())
  pageId     String
  page       ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  snapshot   Json
  reason     String?
  actorId    String?
  actorLabel String?
  createdAt  DateTime    @default(now())

  @@index([pageId, createdAt])
}

model HomeSection {
  id        String    @id @default(uuid())
  key       String    @unique
  title     String?
  subtitle  String?
  content   Json
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([active, sortOrder])
  @@index([deletedAt])
}

model SocialLink {
  id        String    @id @default(uuid())
  platform  String
  label     String?
  url       String
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([active, sortOrder])
  @@index([deletedAt])
}
